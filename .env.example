# Token del bot de Telegram (te lo da @BotFather)
BOT_TOKEN=

# ID del chat/canal/grupo de Telegram donde se publican las señales
# (usa @userinfobot o el método getUpdates para averiguarlo; los grupos/canales suelen empezar por -100)
CHAT_ID=

# URL pública donde queda desplegado el bot, sin barra final
# Ej: https://tu-proyecto.up.railway.app
APP_URL=

# Puerto en el que escucha el servidor (Railway lo inyecta automáticamente)
PORT=8080

# Secreto compartido para validar que las alertas de TradingView son legítimas.
# Debe incluirse en el JSON de la alerta como "secret": "el_mismo_valor".
TV_WEBHOOK_SECRET=

# Secreto que Telegram reenviará en la cabecera X-Telegram-Bot-Api-Secret-Token
# para validar que las peticiones a /tg_webhook vienen realmente de Telegram.
TG_WEBHOOK_SECRET=
